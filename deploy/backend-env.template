# Backend environment variables for Legacy Code Whisperer
# Copy to /opt/legacy-code-whisperer/backend.env and fill in actual values.
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS.
#
# This file is sourced by the systemd service.
# The service runs as the 'lcw' user.

# ============================================================
# REQUIRED IN PRODUCTION
# ============================================================
NODE_ENV=production

# Backend listens on loopback only; nginx proxies from :443
PORT=3001
HOST=127.0.0.1

# Server-side bearer token for API authentication.
# Must be >= 32 characters (enforced by backend/config.ts).
# Generate with: openssl rand -hex 32
API_AUTH_TOKEN=REPLACE_WITH_ACTUAL_TOKEN

# Exact frontend origin for CORS.
# Must use HTTPS outside localhost (enforced by backend/config.ts).
# Format: https://domain.example (no path, no trailing slash)
FRONTEND_ORIGIN=https://your-domain.example

# ============================================================
# OPTIONAL
# ============================================================
# Uncomment and adjust if needed
# LOG_LEVEL=info