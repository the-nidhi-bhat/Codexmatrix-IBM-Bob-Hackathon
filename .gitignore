.next/
out/
*.pyc

# Ephemeral validation and checkpoint output (reproducible run records are
# written by tools/checkpoint.js on every run; see validation/README.md)
validation/*.json

# Host-side install of the legacy app. The reference runtime is the Node 6
# container and the reproducible lock is legacy/get24-baseline/repro/npm-shrinkwrap.json,
# so a lockfile generated by a modern host npm must never be committed.
/package-lock.json
