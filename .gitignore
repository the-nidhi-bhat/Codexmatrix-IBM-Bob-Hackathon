# Environment & secrets
.env
.env.*
*.env
!.env.example
.env.local
.env.development
.env.production
secrets.*
*.pem
*.key
*.p12
*.pfx

# Dependency directories
node_modules/
__pycache__/
.venv/
venv/
env/
*.egg-info/
dist/
build/

# OS & editor artifacts
.DS_Store
Thumbs.db
*.swp
